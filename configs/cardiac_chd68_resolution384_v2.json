    "scale_delta": 0.05,
    "intensity_shift": 0.03,
    "noise_std": 0.01,
    "flips": false
  },
  "sampling": "all_foreground_slices_plus_at_most_equal_background_per_case",
  "precision": "FP32",
  "benchmark_warmup_batches": 5,
  "sanity_batches": 20,
  "full_training_authorized": false,
  "external_NII_in_training": false,
  "HD95_ASSD_mm_enabled": false,
  "allowed_partitions": [
    "train",
    "validation"
  ],
  "baseline_config": "configs/cardiac_chd68_runpod_v1.json",
  "single_changed_factor": "input_size: 256 -> 384; identical original slices and all training hyperparameters"
}
