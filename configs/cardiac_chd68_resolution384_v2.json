{
  "version": 1,
  "experiment_scope": "CHD68 resolution-only validation experiment; not an age-verified pediatric cohort",
  "data_root": "/workspace/cardiac_chd68_resolution384_v2",
  "reserve_GB": 10,
  "cohort": "metadata/pediatric/cardiac_chd68_cohort_v1.json",
  "split": "configs/splits/cardiac_chd68_v1.json",
  "preprocessing": "configs/cardiac_chd68_preprocessing_resolution384_v2.json",
  "cache_relative_path": "preprocessing/cardiac_chd68_resolution384_v2",
  "outputs_relative_path": "experiments/cardiac_chd68_resolution384_v2",
  "checkpoint_relative_path": "checkpoints/cardiac_chd68_resolution384_v2",
  "input_size": 384,
  "model": {
    "input_channels": 5,
    "encoder_channels": [
      16,
      32,
      64,
      128
    ],
    "norm_groups": 8,
    "output_channels": 8
  },
  "batch_size": 16,
  "cpu_threads": 6,
  "num_workers": 0,
  "seed": 20261009,
  "epochs": 30,
  "learning_rate": 0.001,
  "optimizer": "Adam",
  "scheduler": "none_fixed_learning_rate",
  "loss": {
    "variant": "ce_dice",
